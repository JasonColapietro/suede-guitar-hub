      "id": "g-l1-m3-04",
      "prerequisiteLessonIds": [
        "g-l1-m3-01",
        "g-l1-m3-02"
      ],
      "quiz": {
        "scoring": "Earn one point for each question answered correctly on the first try. There are ten questions and no time bonus. Eight correct answers meets this checkpoint.",
        "passingCorrectCount": 8,
        "items": [
          {
            "id": "read-01",
            "kind": "tab",
            "prompt": "Which guitar string does the top line of this labeled tab represent?",
            "options": [
              "String 1, thin high E",
              "String 6, thick low E",
              "String 3, G"
            ],
            "correctOptionIndex": 0,
            "explanation": "Standard horizontal guitar tab places the highest-pitched string at the top."
          },
          {
            "id": "read-02",
            "kind": "tab",
            "prompt": "A 0 is written on string 1. What do you do?",
            "options": [
              "Fret the first fret",
              "Play string 1 open",
              "Leave string 1 silent"
            ],
            "correctOptionIndex": 1,
            "explanation": "Zero means play without fretting that string."
          },
          {
            "id": "read-03",
            "kind": "tab",
            "prompt": "A 2 is written on the B-string line. Which position does it name?",
            "options": [
              "String 2, fret 2",
              "String 2, any fret with finger 2",
              "String 5, fret 2"
            ],
            "correctOptionIndex": 0,
            "explanation": "The line identifies the string; the number identifies the fret."
          },
          {
            "id": "read-04",
            "kind": "tab",
            "prompt": "A 3 is written on the high-E line. Where do you point?",
            "options": [
              "String 3, open",
              "String 6, fret 3",
              "String 1, fret 3"
            ],
            "correctOptionIndex": 2,
            "explanation": "High E is string 1, and the tab number requests fret 3."
          },
          {
            "id": "read-05",
            "kind": "chord_symbol",
            "prompt": "What does X above a string in a chord box mean?",
            "options": [
              "Play it extra loudly",
              "Keep that string silent",
              "Play it open"
            ],
            "correctOptionIndex": 1,
            "explanation": "X marks a string that should not sound in this shape."
          },
          {
            "id": "read-06",
            "kind": "chord_symbol",
            "prompt": "What does O above a string mean?",
            "options": [
              "Play the open string",
              "Mute the string",
              "Use your thumb to fret it"
            ],
            "correctOptionIndex": 0,
            "explanation": "O identifies a sounding string without a fretted position."
          },
          {
            "id": "read-07",
            "kind": "chord_name",
            "demoAssetId": "a-chord-reading",
            "hideAssetName": true,
            "prompt": "Which introduced chord does this diagram show?",
            "options": [
              "D",
              "A",
              "The diagram names a single fret"
            ],
            "correctOptionIndex": 1,
            "explanation": "This A shape has fretted positions on strings 4, 3, and 2 at fret 2, with string 5 open."
          },
          {
            "id": "read-08",
            "kind": "chord_name",
            "demoAssetId": "d-chord-reading",
            "hideAssetName": true,
            "prompt": "Which introduced chord does this diagram show?",
            "options": [
              "A",
              "The diagram names a single string",
              "D"
            ],
            "correctOptionIndex": 2,
            "explanation": "This D shape has an open fourth string, two fret-2 positions, and the B-string position at fret 3."
          },
          {
            "id": "read-09",
            "kind": "rhythm",
            "demoAssetId": "four-beat-reading",
            "prompt": "This 4/4 bar contains one quarter-note slash on each numbered beat. How many strokes are written?",
            "options": [
              "One",
              "Four",
              "Eight"
            ],
            "correctOptionIndex": 1,
            "explanation": "The displayed bar has four beats and one written stroke per beat."
          },
          {
            "id": "read-10",
            "kind": "chord_start",
            "demoAssetId": "d-chord-reading",
            "prompt": "What is the lowest sounding string in this D diagram?",
            "options": [
              "String 6",
              "String 5",
              "String 4"
            ],
            "correctOptionIndex": 2,
            "explanation": "Strings 6 and 5 are marked X; string 4 is the first sounding string."
          }
        ]
      }
    },
