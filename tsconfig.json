{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    // `node --test --experimental-strip-types` runs the files in `tests/` as real
    // ESM, and Node's ESM resolver does no extension guessing: a test has to
    // import `../lib/tempo.ts` with the extension written out or the import
    // fails at runtime. TypeScript rejects that spelling unless this is on, so
    // without it `tsc --noEmit` and `node --test` cannot both pass. Legal here
    // because `noEmit` is set, so nothing is ever emitted with a `.ts` specifier
    // left in it.
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
