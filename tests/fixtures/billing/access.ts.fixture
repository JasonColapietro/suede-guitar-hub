import {resolveAccount} from './server';
import {reconcileLearningAccess} from './handlers';
import {getWebLifetimeAccess} from '../learning-billing/runtime';
import type {LearningTrack} from '../learning-account/contracts';
export type VerifiedLearningAccess={enabled:boolean;accountId:string|null;tracks:LearningTrack[];status:'disabled'|'signedOut'|'verified'|'unavailable'};
export async function getVerifiedLearningAccess():Promise<VerifiedLearningAccess>{
 const account=await resolveAccount();if(!account)return{enabled:true,accountId:null,tracks:[],status:'signedOut'};
 try{const access=await reconcileLearningAccess({webAccess:getWebLifetimeAccess,environment:()=>'Sandbox',listPurchases:async()=>[],recordPurchase:async(_,p)=>p,verifier:async()=>{throw Error('No fixture Apple purchase');}},account.user.id);return{enabled:true,accountId:account.user.id,tracks:access.tracks,status:'verified'};}
 catch{return{enabled:true,accountId:account.user.id,tracks:[],status:'unavailable'};}
}
